# ========================================================
# FX_LangGraph Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit your .env file to Git or GitHub!
# ========================================================

# LLM Provider (Choose OpenRouter or standard OpenAI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Web Research Engine
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Image Generation (Gemini Imagen 3)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: HuggingFace Token (if using HF inference endpoints)
HF_TOKEN=your_huggingface_token_here
